{
  "name": "expo-android-glass-view",
  "version": "0.1.7",
  "description": "Liquid Glass views, buttons, sliders and toggles for React Native on Android (Jetpack Compose, powered by Kyant0/AndroidLiquidGlass)",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "scripts": {
    "build": "node internal/module_scripts/build.js",
    "clean": "node internal/module_scripts/clean.js",
    "lint": "eslint src/",
    "test": "node internal/module_scripts/test.js",
    "prepare": "node internal/module_scripts/prepare.js",
    "open:ios": "node internal/module_scripts/open-ios.js",
    "open:android": "node internal/module_scripts/open-android.js"
  },
  "keywords": [
    "react-native",
    "expo",
    "android",
    "liquid-glass",
    "glassmorphism",
    "jetpack-compose",
    "expo-android-glass-view"
  ],
  "repository": "https://github.com/kagantemizkan/expo-android-glass-view",
  "bugs": {
    "url": "https://github.com/kagantemizkan/expo-android-glass-view/issues"
  },
  "author": "Kağan Temizkan <info@sailatlas.app> (https://sailatlas.app)",
  "license": "Apache-2.0",
  "homepage": "https://github.com/kagantemizkan/expo-android-glass-view#readme",
  "dependencies": {},
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/jest": "^29.2.1",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~57.0.11",
    "eslint": "~9.39.4",
    "eslint-config-universe": "^15.0.3",
    "expo": "^57.0.21",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "prettier": "^3.0.0",
    "react-native": "0.86.3",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "roots": [
      "<rootDir>/src"
    ]
  },
  "peerDependencies": {
    "expo": "*",
    "react": "*",
    "react-native": "*"
  }
